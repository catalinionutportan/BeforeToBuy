// BeforeToBuy — Supabase PostgreSQL catalogue (offline feed import).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Changed in the same transaction as an offline catalogue publication.
model CatalogRevision {
  country   String   @id
  revision  String
  updatedAt DateTime @default(now()) @updatedAt
}

model Product {
  id              String    @id
  title           String
  description     String?
  gtin            String?
  brand           String?
  category        String
  image           String?
  catalogSource   String    @default("production-live")
  targetCountries String[]
  basePrice       Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  offers Offer[] @relation("ProductOffers")

  @@index([category])
  @@index([brand])
  @@index([catalogSource])
  @@index([targetCountries], type: Gin)
  @@index([updatedAt, id])
}

model Offer {
  id                 String   @id
  productId          String
  storeName          String
  price              Float
  originalPrice      Float?
  discountPercentage Float?
  currency           String
  inStock            Boolean  @default(true)
  deliveryTime       String?
  deliveryCost       Float?
  totalPrice         Float?
  purchaseUrl        String
  affiliateNetwork   String?
  source             String   @default("production-live")
  feedMerchantId     String?
  merchantProductId  String?
  fetchedAt          String

  product Product @relation("ProductOffers", fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeName])
  @@index([feedMerchantId])
  @@index([productId])
  @@index([productId, inStock])
}
