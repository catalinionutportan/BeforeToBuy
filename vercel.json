{
  "regions": ["dub1"],
  "functions": {
    "src/app/api/products/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/price-snapshot/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/feeds-warm/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/browse-warm/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/price-snapshot",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/feeds-warm",
      "schedule": "20 */6 * * *"
    },
    {
      "path": "/api/cron/browse-warm",
      "schedule": "*/5 * * * *"
    }
  ]
}
