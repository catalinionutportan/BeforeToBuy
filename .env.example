# BeforeToBuy.com — environment template (Phase 1+)
# Copy to .env.local for local development. Do not commit secrets.

# Required in production: signs the HttpOnly consent cookie used by location APIs.
# Generate with: openssl rand -base64 48
# CONSENT_SIGNING_SECRET=

# Merchant feed integrations (C4)
# Set a feed URL to switch that merchant from sample data to production-live offers.

# AWIN CSV feeds (Brack, MediaMarkt, Interdiscount, Fust, Seentat)
# AWIN_FEED_URL_CH_BRACK=https://productdata.awin.com/datafeed/download/...
# AWIN_FEED_URL_CH=https://productdata.awin.com/datafeed/download/...  # legacy alias for Brack
# AWIN_FEED_URL_CH_MEDIAMARKT=
# AWIN_FEED_URL_CH_INTERDISCOUNT=
# AWIN_FEED_URL_CH_FUST=
# Preferred: publisher API key (builds Seentat URL via awinFeedId — never commit the key)
# AWIN_API_KEY=
# Or full feed URL override (also never commit):
# AWIN_FEED_URL_GB_SEENTAT=

# Galaxus merchant JSON feeds (Digitec, Galaxus)
# GALAXUS_FEED_URL_CH_DIGITEC=
# GALAXUS_FEED_URL_CH_GALAXUS=

# Google Merchant XML feeds (Romania)
# GOOGLE_MERCHANT_FEED_URL_RO_SCULE365=https://www.scule365.ro/feed/google_xml/ea1c1391c197733db36fe91ee7e0b901

# AWIN coupon API (future)
# AWIN_PUBLISHER_ID=
# AWIN_API_TOKEN=

# Amazon PA-API (Phase 4+ — requires approved Associates account)
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=

# Optional contact delivery (Phase 3)
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=BeforeToBuy <onboarding@resend.dev>
# CONTACT_TO_EMAIL=admin@portanx.com

# Price history + API rate limiting (Upstash Redis)
# Prefer Vercel Marketplace → Storage → Upstash Redis (auto-injects env vars).
# Accepted names (either pair works):
#   UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=
#   KV_REST_API_URL= / KV_REST_API_TOKEN=   (legacy Vercel KV / Marketplace alias)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# CRON_SECRET=  # Required for /api/cron/price-snapshot (Vercel Cron sends Bearer token)
# INTERNAL_API_SECRET=  # Optional; protects /api/health, /api/mapping/report, /api/integrations/status (falls back to CRON_SECRET)
# TRUST_PROXY=1  # Only set behind a trusted reverse proxy outside Vercel (enables x-forwarded-for)
